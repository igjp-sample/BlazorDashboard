@page "/"
@using System.Data
@using static BlazorDashboard.Components.DashboardMenu
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject I18nText I18n
@inject DashboardService DashboardService
@inject DockManagerHelper Helper

<PageTitle>@_T.BlazorDashboard</PageTitle>

<Header OnClickAddComponent="OnClickAddComponent" />

<main>
    @if (_initializedCompletionSource.Task.IsCompleted)
    {
        <IgbDockManager id="dockmanager1" Layout="this.GetInitialLayout()">
            @foreach (var component in this.Components)
            {
                <div @key="component.Id" slot="@component.Id" class="dockmanager-content">
                    @if (component.ComponentName == nameof(DashboardMenu))
                    {
                        <DashboardMenu OnSelectedItemCallback="OnSelectedDashboard" DataTable="SelectedDataTable"></DashboardMenu>
                    }
                    @if (component.ComponentName == nameof(GridView))
                    {
                        <GridView GridDataTable="@SelectedDataTable"></GridView>
                    }
                    @if (component.ComponentName == nameof(ChartView))
                    {
                        <ChartView DataTable="@SelectedDataTable"></ChartView>
                    }
                </div>
            }
        </IgbDockManager>
    }
</main>

<footer>
    <a href="https://jp.infragistics.com/products/ignite-ui-blazor" target="_blank" class="appendix-link">
        Powered by Ignite UI for Blazor | Infragistics
    </a>
</footer>

@code {
    private DataTable? SelectedDataTable;

    /// <summary>
    /// 最後に購読破棄するために、ドックマネージャーのイベント購読を保持するリスト
    /// </summary>
    private readonly List<IAsyncDisposable> _Subscriptions = new();

    public record ComponentDescriptor(string Id, string HeaderText, string ComponentName);

    /// <summary>
    /// "画面上にどのコンポーネントが表示されているか" を保持するリスト
    /// </summary>
    private readonly List<ComponentDescriptor> Components = new();

    /// <summary>
    /// 初期リスト
    /// </summary>
    private IEnumerable<ComponentDescriptor> GetInitialComponents()
    {
        return new ComponentDescriptor[]
          {
            new(Id:"content1", _T.DataSource, ComponentName:nameof(DashboardMenu)),
            new(Id:"content2", _T.DataGrid, ComponentName:nameof(GridView)),
            new(Id:"content3", _T.Chart, ComponentName:nameof(ChartView)),
          };
    }

    /// <summary>
    /// ドックマネージャーの初期レイアウト
    /// </summary>
    private IgbDockManagerLayout? _InitialLayout = null;

#pragma warning disable BL0005
    private IgbDockManagerLayout GetInitialLayout()
    {
        return _InitialLayout ??= new IgbDockManagerLayout
        {
            RootPane = new IgbSplitPane
            {
                PaneType = DockManagerPaneType.SplitPane,
                Orientation = SplitPaneOrientation.Horizontal,
            }.WithPanes(
                    new IgbContentPane
                    {
                        PaneType = DockManagerPaneType.ContentPane,
                        ContentId = "content1",
                        Header = _T.DataSource,
                        Size = 25
                    },
                    new IgbSplitPane
                    {
                        PaneType = DockManagerPaneType.SplitPane,
                        Orientation = SplitPaneOrientation.Vertical,
                        Size = 75,
                    }.WithPanes(
                        new IgbContentPane
                        {
                            PaneType = DockManagerPaneType.ContentPane,
                            ContentId = "content2",
                            Header = _T.DataGrid,
                            Size = 100
                        },
                        new IgbContentPane
                        {
                            PaneType = DockManagerPaneType.ContentPane,
                            ContentId = "content3",
                            Header = _T.Chart,
                            Size = 200
                        }
                    )
                )
        };
    }
#pragma warning restore BL0005

    private LocalizedText _T = new();

    private readonly TaskCompletionSource _initializedCompletionSource = new();

    protected override async Task OnInitializedAsync()
    {
        _T = await this.I18n.GetTextTableAsync<LocalizedText>(this);
        _initializedCompletionSource.SetResult();
    }

    /// <summary>
    /// ダッシュボード選択時に呼び出されます。
    /// </summary>
    private void OnSelectedDashboard(MenuSelectedEventArgs e)
    {
        this.SelectedDataTable = e.SelectedItem.DataTable;
    }

    /// <summary>
    /// 描画が完了するたびに呼び出されます (以降、ローカルストレージへのアクセスが可能になります)
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _initializedCompletionSource.Task;

            // ドックマネージャーが発行するイベントを購読
            this._Subscriptions.Add(await this.Helper.SubscribeLayoutChangeEventAsync("#dockmanager1", OnLayoutChange));
            this._Subscriptions.Add(await this.Helper.SubscribePaneCloseEventAsync("#dockmanager1", OnPaneClose));

            var componentsJson = await this.JS.InvokeAsync<string?>("localStorage.getItem", "BlazorDashboard/components");
            var layout = await this.JS.InvokeAsync<string?>("localStorage.getItem", "BlazorDashboard/layout");
            if (string.IsNullOrEmpty(componentsJson) || string.IsNullOrEmpty(layout))
            {
                await this.JS.InvokeAsync<string?>("localStorage.setItem", "BlazorDashboard/components", "");
                await this.JS.InvokeAsync<string?>("localStorage.setItem", "BlazorDashboard/layout", "");
                this.Components.AddRange(GetInitialComponents());
                this.StateHasChanged();
                return;
            }

            // ブラウザのローカルストレージに JSON 形式で保存しておいた表示コンポーネントの情報を、逆シリアル化して復元
            var components = JsonSerializer.Deserialize<ComponentDescriptor[]>(componentsJson ?? "null");
            this.Components.AddRange(components ?? GetInitialComponents());
            this.StateHasChanged();

            // ブラウザのローカルストレージに保存しておいたドックマネージャーのレイアウト情報から、レイアウトを復元
            await this.Helper.RestoreLayoutAsync("#dockmanager1", layout);

            this.StateHasChanged();
        }
    }

    private async Task OnClickAddComponent(string componentName)
    {
        var id = Guid.NewGuid().ToString();
        var descriptor = componentName switch
        {
            nameof(DashboardMenu) => new ComponentDescriptor(id, _T.DataSource, componentName),
            nameof(GridView) => new ComponentDescriptor(id, _T.DataGrid, componentName),
            nameof(ChartView) => new ComponentDescriptor(id, _T.Chart, componentName),
            _ => throw new Exception()
        };
        await this.AddComponentAsync(descriptor);
    }

    /// <summary>
    /// 表示コンポーネントの追加処理を集約します。
    /// </summary>
    private async ValueTask AddComponentAsync(ComponentDescriptor descriptor)
    {
        this.Components.Add(descriptor);

        // ドックマネージャーに、追加した表示コンポーネントを取り付け
        await this.Helper.AttachContentPaneAsync("#dockmanager1", descriptor.Id, descriptor.HeaderText);

        // 表示コンポーネントの情報を、ブラウザのローカルストレージに保存
        var componentsJson = JsonSerializer.Serialize(this.Components);
        await this.JS.InvokeVoidAsync("localStorage.setItem", "BlazorDashboard/components", componentsJson);
    }

    /// <summary>
    /// ドックマネージャーのレイアウトが変更されたときに呼び出され、変更後のレイアウト情報をブラウザのローカルストレージに保存します。
    /// </summary>
    private async ValueTask OnLayoutChange(string? layout)
    {
        if (layout == null) return;
        await this.JS.InvokeVoidAsync("localStorage.setItem", "BlazorDashboard/layout", layout);
    }

    /// <summary>
    /// ドックマネージャーのペインが閉じられたときに呼び出され、閉じられたペインに表示していた表示コンポーネントを削除し、ブラウザのローカルストレージに保存します。
    /// </summary>
    private async ValueTask OnPaneClose(string[]? closedPaneIds)
    {
        var componentsToRemove = (closedPaneIds ?? Array.Empty<string>())
            .Select(paneId => this.Components.Find(descriptor => descriptor.Id == paneId))
            .Where(descriptor => descriptor != null)
            .ToArray();
        foreach (var descriptor in componentsToRemove) { this.Components.Remove(descriptor!); }

        var componentsJson = JsonSerializer.Serialize(this.Components);
        await this.JS.InvokeVoidAsync("localStorage.setItem", "BlazorDashboard/components", componentsJson);
        this.StateHasChanged();
    }

    /// <summary>
    /// このコンポーネントが破棄されるときに呼び出され、購読していたドックマネージャーのイベント購読を破棄します。
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        var valueTasks = this._Subscriptions.Select(subscription => subscription.DisposeAsync()).ToArray();
        foreach (var valueTask in valueTasks) await valueTask;
    }
}